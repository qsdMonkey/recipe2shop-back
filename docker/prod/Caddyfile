# Caddy en HTTP seul, derrière le reverse proxy HTTPS (qui gère TLS, les en-têtes X-Forwarded-* et les timeouts).
{
	admin off
	auto_https off
	frankenphp
}

:8080 {
	root * /app/public
	encode zstd gzip

	# Corps JSON : petits, sauf un message avec photo (2 Mo décodés ≈ 2,7 Mo en base64) : 4 Mo max.
	request_body {
		max_size 4MB
	}

	header -Server

	php_server
}
